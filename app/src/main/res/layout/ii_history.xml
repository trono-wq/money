<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN ACTION BAR - Layout, Position-->
    <LinearLayout
        android:id="@+id/main_action_bar"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- MAIN HISTORY - Layout, Font -->
        <TextView
            android:id="@+id/b_ab_history"
            android:text="@string/b_ab_history"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textStyle="bold"
            android:textSize="25sp"
            android:textColor="#fbd722"/>

        <!-- SEPARATOR - Layout, Font -->
        <TextView
            android:text="@string/ab_separator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- MONEY Layout, Font, Interact -->
        <TextView
            android:id="@+id/ab_money"
            android:text="@string/ab_money"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"

            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- SCROLL -->
    <ScrollView
        android:id="@+id/no"

        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/main_action_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BUTTON BAR -->
        <LinearLayout
            android:id="@+id/button_bar"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">

            <!-- WM - Layout, Font -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/b_ab_wm"
                android:text="@string/b_ab_wm"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#666666"

                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textAllCaps="false" />

            <!-- WEEK - Layout, Font -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/b_ab_week"
                android:text="@string/b_ab_week"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#666666"

                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textAllCaps="false"/>

            <!-- DEBT - Layout, Font -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/b_ab_debt"
                android:text="@string/b_ab_debt"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#666666"

                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textAllCaps="false"/>

            <!-- CREDIT - Layout, Font -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/b_ab_credit"
                android:text="@string/b_ab_credit"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#666666"

                android:textColor="#FFFFFF"
                android:textAllCaps="false"/>
        </LinearLayout>
    </ScrollView>

    <!-- SCROLL -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/main_action_bar">
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>