<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN ACTION BAR - Layout, Position -->
    <LinearLayout
        android:id="@+id/main_action_bar"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"

        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- MAIN NOTES - Layout, Styling -->
        <TextView
            android:text="@string/ab_notes"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textStyle="bold"
            android:textSize="25sp"
            android:textColor="#fbd722"/>

        <!-- SEPARATOR - Layout, Styling -->
        <TextView
            android:text="@string/ab_separator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- MONEY - Layout, Styling, Interact -->
        <TextView
            android:id="@+id/ab_money"
            android:text="@string/ab_money"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"

            android:clickable="true"
            android:focusable="true"/>

        <!-- SEPARATOR - Layout, Styling -->
        <TextView
            android:text="@string/ab_separator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- CALCULATOR - Layout, Styling, Interact -->
        <TextView
            android:id="@+id/ab_calculator"
            android:text="@string/ab_calculator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"

            android:clickable="true"
            android:focusable="true"/>

        <!-- SEPARATOR - Layout, Styling -->
        <TextView
            android:text="@string/ab_separator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- STATUS - Layout, Styling, Interact -->
        <TextView
            android:id="@+id/ab_status"
            android:text="@string/ab_status"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"

            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- SCROLL -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/main_action_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- SCROLL LAYOUT -->
        <LinearLayout
            android:id="@+id/places_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:layout_marginTop="48dp">

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:singleLine="false"
                android:scrollHorizontally="false"
                android:minLines="1"
                android:backgroundTint="@null"
                android:background="@null"


                android:textColor="#FFFFFF"
                android:textColorHint="#999999"
                android:textSize="15sp"
                android:hint="Notes"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
