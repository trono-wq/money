<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN ACTION BAR -->
    <LinearLayout
        android:id="@+id/main_action_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- MAIN STATUS -->
        <TextView
            android:text="@string/ab_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textStyle="bold"
            android:textSize="25sp"
            android:textColor="#fbd722"/>

        <!-- SEPARATOR -->
        <TextView
            android:text="@string/ab_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- MONEY -->
        <TextView
            android:id="@+id/ab_money"
            android:text="@string/ab_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"
            android:clickable="true"
            android:focusable="true"/>

        <!-- SEPARATOR -->
        <TextView
            android:text="@string/ab_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- CALCULATOR -->
        <TextView
            android:id="@+id/ab_calculator"
            android:text="@string/ab_calculator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"
            android:clickable="true"
            android:focusable="true"/>

        <!-- SEPARATOR -->
        <TextView
            android:text="@string/ab_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- NOTES -->
        <TextView
            android:id="@+id/ab_notes"
            android:text="@string/ab_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- PLACES TABLE -->
    <LinearLayout
        android:id="@+id/places_action_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        app:layout_constraintTop_toBottomOf="@id/main_action_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- LEFT COLUMN -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:text="@string/s_d_spent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="start"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:padding="5dp"/>

            <TextView
                android:text="@string/s_d_debt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="start"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:padding="5dp"/>

            <TextView
                android:text="@string/s_d_credit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="start"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:padding="5dp"/>

            <TextView
                android:text="@string/s_d_allowance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="start"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:padding="5dp"/>

            <TextView
                android:text="@string/s_d_leftover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="start"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:padding="5dp"/>

        </LinearLayout>

        <!-- RIGHT COLUMN -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:text="@string/s_s_spent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:padding="5dp"/>

            <TextView
                android:text="@string/s_s_debt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:padding="5dp"/>

            <TextView
                android:text="@string/s_s_credit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:padding="5dp"/>

            <TextView
                android:text="@string/s_s_allowance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:padding="5dp"/>

            <TextView
                android:text="@string/s_s_leftover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:padding="5dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
