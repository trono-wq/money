<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- MAIN ACTION BAR -->
    <LinearLayout
        android:id="@+id/main_action_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- MAIN STATUS -->
        <TextView
            android:text="@string/ab_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textStyle="bold"
            android:textSize="25sp"
            android:textColor="#fbd722"/>

        <!-- SEPARATOR -->
        <TextView
            android:text="@string/ab_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- MONEY -->
        <TextView
            android:id="@+id/ab_money"
            android:text="@string/ab_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"
            android:clickable="true"
            android:focusable="true"/>

        <!-- SEPARATOR -->
        <TextView
            android:text="@string/ab_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- CALCULATOR -->
        <TextView
            android:id="@+id/ab_calculator"
            android:text="@string/ab_calculator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"
            android:clickable="true"
            android:focusable="true"/>

        <!-- SEPARATOR -->
        <TextView
            android:text="@string/ab_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- NOTES -->
        <TextView
            android:id="@+id/ab_notes"
            android:text="@string/ab_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"
            android:clickable="true"
            android:focusable="true"/>

        <!-- SEPARATOR - Layout, Styling -->
        <TextView
            android:text="@string/ab_separator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- CALCULATOR - Layout, Styling, Interact -->
        <TextView
            android:id="@+id/ab_flight"
            android:text="Flight"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"

            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/button_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/main_action_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/s_b_edit"
            android:backgroundTint="#666666"
            android:text="@string/d_b_edit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- PLACES TABLE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/button_bar">

        <!-- ENTER BAR -->

        <!-- INPUT BAR -->
        <LinearLayout
            android:id="@+id/input_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.10"
            android:orientation="vertical">

            <EditText
                android:text="@string/s_d_leftover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:padding="5dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <EditText
                android:text="@string/s_d_spent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:padding="5dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <EditText
                android:text="@string/s_d_allowance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:padding="5dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <EditText
                android:text="@string/s_d_debt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:padding="5dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <EditText
                android:text="@string/s_d_credit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:padding="5dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/enter_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.90"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:text="@string/s_s_leftover"
                    android:id="@+id/s_s_leftover"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:padding="5dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="15sp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/s_b_leftover"

                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:backgroundTint="#666666"
                    android:padding="0dp"
                    android:text="C"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:text="@string/s_s_spent"
                    android:id="@+id/s_s_spent"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:padding="5dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="15sp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/s_b_spent"

                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:backgroundTint="#666666"
                    android:padding="0dp"
                    android:text="C"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:text="@string/s_s_allowance"
                    android:id="@+id/s_s_allowance"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:padding="5dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="15sp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/s_b_allowance"

                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:backgroundTint="#666666"
                    android:padding="0dp"
                    android:text="C"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:text="@string/s_s_debt"
                    android:id="@+id/s_s_debt"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:padding="5dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="15sp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/s_b_debt"

                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:backgroundTint="#666666"
                    android:padding="0dp"
                    android:text="C"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:text="@string/s_s_credit"
                    android:id="@+id/s_s_credit"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:padding="5dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="15sp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/s_b_credit"

                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:backgroundTint="#666666"
                    android:padding="0dp"
                    android:text="C"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
