<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/i_i_calculator"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN ACTION BAR - Layout, Position -->
    <LinearLayout
        android:id="@id/main_action_bar"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"

        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- MAIN CALCULATOR - Layout, Styling -->
        <TextView
            android:text="Flight"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textStyle="bold"
            android:textSize="25sp"
            android:textColor="#fbd722"/>

        <!-- SEPARATOR - Layout, Styling -->
        <TextView
            android:text="@string/ab_separator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- MONEY - Layout, Styling, Interact -->
        <TextView
            android:id="@+id/ab_money"
            android:text="@string/ab_money"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"

            android:clickable="true"
            android:focusable="true"/>

        <!-- SEPARATOR - Layout, Styling -->
        <TextView
            android:text="@string/ab_separator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- CALCULATOR - Layout, Styling, Interact -->
        <TextView
            android:id="@+id/ab_calculator"
            android:text="@string/ab_calculator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"

            android:clickable="true"
            android:focusable="true"/>

        <!-- SEPARATOR - Layout, Styling -->
        <TextView
            android:text="@string/ab_separator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- NOTES - Layout, Styling, Interact -->
        <TextView
            android:id="@+id/ab_notes"
            android:text="@string/ab_notes"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"

            android:clickable="true"
            android:focusable="true"/>

        <!-- SEPARATOR - Layout, Styling -->
        <TextView
            android:text="@string/ab_separator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- STATUS - Layout, Styling, Interact -->
        <TextView
            android:id="@+id/ab_status"
            android:text="@string/ab_status"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"

            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/flight"

        android:layout_width="576dp"
        android:layout_height="647dp"

        android:contentDescription="Picture"
        android:scaleType="fitCenter"

        android:src="@drawable/flight"
        tools:layout_editor_absoluteX="-43dp"
        tools:layout_editor_absoluteY="68dp" />
</androidx.constraintlayout.widget.ConstraintLayout>