<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN ACTION BAR - Layout, Position -->
    <LinearLayout
        android:id="@+id/main_action_bar"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"

        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- MAIN MONEY - Layout, Styling -->
        <TextView
            android:text="@string/ab_money"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textStyle="bold"
            android:textSize="25sp"
            android:textColor="#fbd722"/>

        <!-- SEPARATOR - Layout, Styling -->
        <TextView
            android:text="@string/ab_separator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- CALCULATOR - Layout, Styling, Interact -->
        <TextView
            android:id="@+id/ab_calculator"
            android:text="@string/ab_calculator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"

            android:clickable="true"
            android:focusable="true"/>

        <!-- SEPARATOR - Layout, Styling -->
        <TextView
            android:text="@string/ab_separator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- NOTES - Layout, Styling, Interact -->
        <TextView
            android:id="@+id/ab_notes"
            android:text="@string/ab_notes"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"

            android:clickable="true"
            android:focusable="true"/>

        <!-- SEPARATOR - Layout, Styling -->
        <TextView
            android:text="@string/ab_separator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- STATUS - Layout, Styling, Interact -->
        <TextView
            android:id="@+id/ab_status"
            android:text="@string/ab_status"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"

            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- SCROLL -->
    <!-- SCROLL -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/main_action_bar">

        <!-- SCROLL LAYOUT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- MAIN BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- ENTER BAR -->
                <LinearLayout
                    android:id="@+id/enter_bar"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"

                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="5dp"
                            android:text="@string/m_lb_date"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/m_b_date"
                            android:layout_width="25dp"
                            android:layout_height="30dp"
                            android:backgroundTint="#666666"
                            android:text="@string/m_b_date"
                            android:textColor="#FFFFFF"
                            android:padding="0dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:text="@string/m_lb_allowance"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="5dp"
                            android:text="@string/m_lb_debt"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/m_b_debt"
                            android:layout_width="25dp"
                            android:layout_height="30dp"
                            android:backgroundTint="#666666"
                            android:text="@string/m_b_debt"
                            android:textColor="#FFFFFF"
                            android:padding="0dp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:text="@string/m_lb_debt_n"
                        android:textColor="#666666"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/p2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="5dp"
                            android:text="@string/m_lb_credit"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/m_b_credit"
                            android:layout_width="25dp"
                            android:layout_height="30dp"
                            android:backgroundTint="#666666"
                            android:text="@string/m_b_credit"
                            android:textColor="#FFFFFF"
                            android:padding="0dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:text="@string/m_lb_credit_n"
                        android:textColor="#666666"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:text="@string/m_lb_spent"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- ENTER BAR -->
                <LinearLayout
                    android:id="@+id/input_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/m_i_date"
                        android:layout_width="285dp"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:hint="@string/m_i_date"
                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:clickable="false"
                        android:focusable="false"
                        android:inputType="date"
                        android:importantForAutofill="no"
                        android:background="@null"/>

                    <EditText
                        android:id="@+id/m_i_allowance"
                        android:hint="@string/m_i_allowance"

                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:textSize="15sp"
                        android:background="@null"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"/>

                    <EditText
                        android:id="@+id/m_i_debt"
                        android:hint="@string/m_i_debt"

                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:textSize="15sp"
                        android:background="@null"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"/>

                    <EditText
                        android:id="@+id/m_i_debt_n"
                        android:hint="@string/m_i_debt_n"

                        android:textColorHint="#666666"
                        android:textColor="#666666"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:textSize="15sp"
                        android:background="@null"
                        android:importantForAutofill="no"
                        android:inputType="text"/>

                    <EditText
                        android:id="@+id/m_i_credit"
                        android:hint="@string/m_i_credit"
                        android:importantForAutofill="no"

                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:textSize="15sp"
                        android:background="@null"
                        android:inputType="numberDecimal"/>

                    <EditText
                        android:id="@+id/m_i_credit_n"
                        android:hint="@string/m_i_credit_n"

                        android:textColorHint="#666666"
                        android:textColor="#666666"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:textSize="15sp"
                        android:background="@null"
                        android:importantForAutofill="no"
                        android:inputType="text"/>

                    <EditText
                        android:id="@+id/m_i_spent"
                        android:hint="@string/m_i_spent"

                        android:textColorHint="#666666"
                        android:textColor="#FFFFFF"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:textSize="15sp"
                        android:background="@null"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"/>
                </LinearLayout>
            </LinearLayout>

            <!-- BUTTON BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/ab_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#666666"
                    android:text="@string/b_ab_history"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#666666"
                    android:text="@string/b_save"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
