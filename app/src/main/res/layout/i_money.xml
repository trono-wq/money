<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN ACTION BAR -->
    <LinearLayout
        android:id="@+id/main_action_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:text="@string/ab_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textStyle="bold"
            android:textSize="25sp"
            android:textColor="#fbd722"/>

        <TextView
            android:text="@string/ab_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <TextView
            android:id="@+id/ab_calculator"
            android:text="@string/ab_calculator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:text="@string/ab_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <TextView
            android:id="@+id/ab_notes"
            android:text="@string/ab_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:text="@string/ab_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <TextView
            android:id="@+id/ab_status"
            android:text="@string/ab_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"
            android:clickable="true"
            android:focusable="true"/>

        <!-- SEPARATOR - Layout, Styling -->
        <TextView
            android:text="@string/ab_separator"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#d39a00"/>

        <!-- CALCULATOR - Layout, Styling, Interact -->
        <TextView
            android:id="@+id/ab_flight"
            android:text="Flight"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="5dp"
            android:textSize="15sp"
            android:textColor="#d39a00"

            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- DEBT / CREDIT BUTTONS -->
    <LinearLayout
        android:id="@+id/button_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/main_action_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- WM - Layout, Font -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/b_ab_debt"
            android:text="@string/b_ab_debt"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#666666"

            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false" />

        <!-- WEEK - Layout, Font -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/b_ab_credit"
            android:text="@string/b_ab_credit"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#666666"

            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false"/>

        <!-- DEBT - Layout, Font -->
        <androidx.appcompat.widget.AppCompatButton

            android:id="@+id/b_clear_all"
            android:text="@string/b_clear_all"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#666666"

            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false"/>

        <!-- CREDIT - Layout, Font -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/save"
            android:text="@string/b_save"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#666666"

            android:textColor="#FFFFFF"
            android:textAllCaps="false"/>
    </LinearLayout>

    <!-- CONTENT CONTAINER -->
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/button_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- SCROLLABLE HORIZONTAL CONTENT -->
        <ScrollView
            android:id="@+id/scroll_view"

            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"

            android:fillViewport="false"
            android:scrollbars="vertical">

            <!-- HORIZONTAL CONTENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- MAIN BAR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- ENTER BAR -->
                    <LinearLayout
                        android:id="@+id/enter_bar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.90"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:padding="5dp"
                                android:text="@string/m_lb_date"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/m_b_date"
                                android:layout_width="25dp"
                                android:layout_height="30dp"
                                android:backgroundTint="#666666"
                                android:padding="0dp"
                                android:text="@string/m_b_date"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:padding="5dp"
                            android:text="@string/m_lb_allowance"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="35dp"
                                android:layout_weight="1"
                                android:padding="5dp"
                                android:text="@string/m_lb_debt"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/m_b_debt"
                                android:layout_width="25dp"
                                android:layout_height="30dp"
                                android:backgroundTint="#666666"
                                android:padding="0dp"
                                android:text="@string/m_b_debt"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:padding="5dp"
                            android:text="@string/m_lb_debt_n"
                            android:textColor="#666666"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:id="@+id/p2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="35dp"
                                android:layout_weight="1"
                                android:padding="5dp"
                                android:text="@string/m_lb_credit"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/m_b_credit"
                                android:layout_width="25dp"
                                android:layout_height="30dp"
                                android:backgroundTint="#666666"
                                android:padding="0dp"
                                android:text="@string/m_b_credit"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:padding="5dp"
                            android:text="@string/m_lb_credit_n"
                            android:textColor="#666666"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:padding="5dp"
                            android:text="@string/m_lb_spent"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- INPUT BAR -->
                    <LinearLayout
                        android:id="@+id/input_bar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.10"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/m_i_date"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:background="@null"
                            android:clickable="false"
                            android:focusable="false"
                            android:hint="@string/m_i_date"
                            android:importantForAutofill="no"
                            android:inputType="date"
                            android:padding="5dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/m_i_allowance"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:background="@null"
                            android:hint="@string/m_i_allowance"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:padding="5dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/m_i_debt"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:background="@null"
                            android:hint="@string/m_i_debt"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:padding="5dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/m_i_debt_n"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:background="@null"
                            android:hint="@string/m_i_debt_n"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:padding="5dp"
                            android:textColor="#666666"
                            android:textColorHint="#666666"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/m_i_credit"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:background="@null"
                            android:hint="@string/m_i_credit"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:padding="5dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/m_i_credit_n"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:background="@null"
                            android:hint="@string/m_i_credit_n"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:padding="5dp"
                            android:textColor="#666666"
                            android:textColorHint="#666666"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/m_i_spent"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:background="@null"
                            android:hint="@string/m_i_spent"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:padding="5dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
